# ===== UK House Invest 环境变量（复制为 backend/.env 使用）=====

# 数据源：onthemarket（默认）| rightmove | mock（离线演示）
UKH_DATA_SOURCE=onthemarket

# 数据库（默认基于项目根目录 data/ukhouse.db，绝对路径最稳妥）
# UKH_DATABASE_URL=sqlite:////absolute/path/ukhouse.db

# 采集
UKH_SCRAPER_TIMEOUT=25

# OnTheMarket 采集参数
UKH_OTHEM_DELAY_SECONDS=0.6
UKH_OTHEM_MAX_PAGES=15
UKH_OTHEM_FETCH_DETAIL=true

# 消失宽限期：连续缺席 N 次同步才判定下架（防瞬时抓取问题误删）
UKH_MISS_THRESHOLD=2

# 每次同步最多抓取多少条详情（控制首次同步耗时，剩余后续补齐）
UKH_OTHEM_DETAIL_PER_SYNC=50

# ===== 通知（留空则不发）=====
# 通用 webhook：同步完成时 POST JSON {"text": "..."}
# UKH_NOTIFY_WEBHOOK_URL=https://hooks.example.com/xyz
# 或 Telegram bot：
# UKH_NOTIFY_TELEGRAM_TOKEN=123456:ABC...
# UKH_NOTIFY_TELEGRAM_CHAT_ID=-1001234567890

# Rightmove（备用适配器，当前网络可能被软封）
UKH_RIGHTMOVE_USE_BROWSER=true
UKH_RIGHTMOVE_HEADLESS=true
UKH_RIGHTMOVE_MAX_PAGES=15
# 浏览器渠道：chrome（用真实 Chrome，反爬表现更好）| 留空用内置 Chromium
# UKH_RIGHTMOVE_CHANNEL=chrome

# 定时同步（Europe/London 本地时间，逗号分隔）
UKH_SCHEDULER_TIMEZONE=Europe/London
UKH_SYNC_TIMES=00:15,08:15,16:15
UKH_SYNC_HOUR=0
UKH_SYNC_MINUTE=0

# 邮件 K 线报告。密码不要写入仓库；GitHub Actions 请配置同名 Secrets。
UKH_SMTP_HOST=smtp.gmail.com
UKH_SMTP_PORT=465
UKH_SMTP_USERNAME=your-account@gmail.com
UKH_SMTP_PASSWORD=your-gmail-app-password
UKH_EMAIL_TO=haha030324@gmail.com
UKH_EMAIL_FROM=your-account@gmail.com
